# Neon Postgres (server-only — never expose to browser)
ORAMA_DATABASE_URL=

# Cloudflare R2 object storage
ORAMA_OBJECT_STORAGE_BUCKET=orama
ORAMA_OBJECT_STORAGE_ENDPOINT=https://4ae744de780b974371d520e056d76b8c.r2.cloudflarestorage.com

# Hugging Face worker (set after HF Space is deployed)
ORAMA_WORKER_URL=

# Shared secret between Vercel and HF worker — generate with: openssl rand -hex 32
ORAMA_WORKER_SHARED_SECRET=

# Public app metadata
NEXT_PUBLIC_APP_NAME=ORAMA Research Platform
NEXT_PUBLIC_APP_URL=https://orama.cerebrallab.org
