# Neon Postgres (server-only — never expose to browser)
ORAMA_DATABASE_URL=

# Cloudflare R2 object storage
ORAMA_OBJECT_STORAGE_BUCKET=orama
ORAMA_OBJECT_STORAGE_ENDPOINT= # R2 endpoint URL from Cloudflare or equivalent S3-compatible service
ORAMA_OBJECT_TOKEN_VALUE= # Token value for accessing the object storage

# Hugging Face worker (set after HF Space is deployed)
ORAMA_WORKER_URL= # URL of the deployed Hugging Face worker
ORAMA_WORKER_HF_TOKEN= # Hugging Face API token for the worker

# Shared secret between Vercel and HF worker — generate with: openssl rand -hex 32
ORAMA_WORKER_SHARED_SECRET= # Shared secret between Vercel and HF worker — generate with: openssl rand -hex 32

# Public app metadata
NEXT_PUBLIC_APP_NAME=ORAMA Research Platform
NEXT_PUBLIC_APP_URL=https://orama.cerebrallab.org