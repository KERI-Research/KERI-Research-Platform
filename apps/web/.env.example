# Neon Postgres (server-only — never expose to browser)
ORAMA_DATABASE_URL=
ORAMA_DATABASE_URL_UNPOOLED= # Direct Neon connection URL used only by Drizzle migrations

# Private Hugging Face worker
ORAMA_WORKER_URL= # URL of the deployed Hugging Face worker
ORAMA_WORKER_SHARED_SECRET= # Shared secret between Vercel and HF worker
ORAMA_APP_URL=https://orama.cerebrallab.org

# Research access and retention controls (server-only)
ORAMA_RESEARCH_ACCESS_TOKEN= # Long random researcher session token
ORAMA_RESEARCH_ACTOR_ID=vercel-research-session
ORAMA_RETENTION_DAYS=30
ORAMA_RETENTION_CRON_SECRET= # Long random token for the scheduled retention route
CRON_SECRET= # Optional Vercel Cron secret; accepted when ORAMA_RETENTION_CRON_SECRET is unset

# Public app metadata
NEXT_PUBLIC_APP_NAME=ORAMA Research Platform
NEXT_PUBLIC_APP_URL=https://orama.cerebrallab.org