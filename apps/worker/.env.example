# Internal worker authentication and callback target
ORAMA_WORKER_SHARED_SECRET=
ORAMA_VERCEL_URL=https://orama.cerebrallab.org
ORAMA_RUNTIME_ENV=production# Cloudflare R2 — S3-compatible credentials (HF Space secrets only, never in code)
AWS_ACCESS_KEY_ID= # Your AWS access key ID
AWS_SECRET_ACCESS_KEY= # Your AWS secret access key
ORAMA_OBJECT_STORAGE_BUCKET=orama
ORAMA_OBJECT_STORAGE_ENDPOINT= # R2 endpoint URL from Cloudflare or equivalent S3-compatible service

# Shared secret — must match ORAMA_WORKER_SHARED_SECRET in Vercel
ORAMA_WORKER_SHARED_SECRET= 

# Vercel app callback base URL
ORAMA_VERCEL_URL= # Vercel app callback base URL
